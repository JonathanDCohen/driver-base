"height":813}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":7628405276758,"title":"HOQS GAN 4X3K Class D amplifier","handle":"hoqs-4x3k-amplifier","body_html":"","published_at":"2025-08-30T13:40:31-05:00","created_at":"2025-08-30T13:40:31-05:00","updated_at":"2026-08-22T16:32:51-05:00","vendor":"HOQS","product_type":"Amplifier","tags":[],"variants":[{"id":42951556563030,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"1500.00","grams":14000,"compare_at_price":null,"position":1,"product_id":7628405276758,"created_at":"2025-08-30T13:40:32-05:00","updated_at":"2026-08-22T16:32:51-05:00"}],"images":[{"id":35025977081942,"created_at":"2025-08-30T13:40:32-05:00","position":1,"updated_at":"2025-08-30T13:40:34-05:00","product_id":7628405276758,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/2028\/1174\/files\/439678564_703813508419814_1963934491225500929_n_1_66587951-8f60-4b75-b909-925750f01747.jpg?v=1756579234","width":2048,"height":1138}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":7560756494422,"title":"HOQS 2x6 MidWave module kit","handle":"hoqs-2x6-midwave-module-kit","body_html":"\u003cp data-start=\"355\" data-end=\"853\"\u003eThe HOQS 2x6 MidWave Module Kit is a multiple entry horn (MEH) waveguide designed to cover the range from approximately 120 Hz to 18 kHz. The horn geometry is optimized to integrate two 6-inch drivers with a 1.4-inch compression driver, allowing all sources to couple into a single waveguide for smooth summation and controlled directivity across the full operating band. This approach provides the efficiency of a horn-loaded system while maintaining broadband coherence and consistent response.\u003c\/p\u003e\n\u003cp data-start=\"855\" data-end=\"1303\"\u003eThe recommended implementation is a 4x6 configuration, which uses two kits per cabinet. In this arrangement, four 6-inch drivers and two compression drivers are combined into one enclosure, significantly increasing output capability and reducing distortion while maintaining uniform dispersion. For system-level performance, cabinets are best deployed in pairs, ensuring adequate headroom and seamless coverage across the intended listening area.\u003c\/p\u003e","published_at":"2025-05-25T19:28:52-05:00","created_at":"2025-05-25T19:28:52-05:00","updated_at":"2026-08-22T16:32:51-05:00","vendor":"HOQS Store","product_type":"Horn","tags":[],"variants":[{"id":42334465359958,"title":"PETG (Any Color)","option1":"PETG (Any Color)","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"215.00","grams":1361,"compare_at_price":null,"position":1,"product_id":7560756494422,"created_at":"2025-05-25T19:28:53-05:00","updated_at":"2026-08-22T16:32:51-05:00"},{"id":42334465392726,"title":"PETG Carbon Fiber (Any Color)","option1":"PETG Carbon Fiber (Any Color)","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"243.00","grams":1361,"compare_at_price":null,"position":2,"product_id":7560756494422,"created_at":"2025-05-25T19:28:53-05:00","updated_at":"2026-08-22T16:32:51-05:00"},{"id":42334465425494,"title":"PA6 Carbon Fiber (Any Color)","option1":"PA6 Carbon Fiber (Any Color)","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"296.00","grams":1361,"compare_at_price":null,"position":3,"product_id":7560756494422,"created_at":"2025-05-25T19:28:53-05:00","updated_at":"2026-08-22T16:32:51-05:00"},{"id":42334465458262,"title":"PET Carbon Fiber (Black)","option1":"PET Carbon Fiber (Black)","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"379.00","grams":1361,"compare_